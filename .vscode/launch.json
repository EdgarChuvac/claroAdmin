{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host", "127.0.0.1",
        "--port", "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DATA_BACKEND": "firestore",
        "LOG_DIR": ""
      },
      "console": "integratedTerminal"
    }
  ]
}
