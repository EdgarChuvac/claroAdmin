# Copie este archivo a .env y complete los valores. Vea AGENTS.md (sección 4) y el README.
# Nunca suba .env al repositorio: es público.

# --- Persistencia ---------------------------------------------------------
# firestore = Cloud Firestore real o emulador | memory = demo sin credenciales (se pierde al reiniciar)
DATA_BACKEND=firestore
FIREBASE_PROJECT_ID=
# Una de las tres opciones de credenciales (o credenciales por defecto de Google en Cloud Run):
FIREBASE_CREDENTIALS_FILE=
# FIREBASE_CREDENTIALS_JSON=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# --- Altas ----------------------------------------------------------------
# PRE-SHARED KEY del bloque de monitoreo NMIS/ISE que se imprime en las altas con loopback.
MONITOREO_PSK=

# --- Aplicación -----------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_FORMAT=json
# Vacío = solo consola
LOG_DIR=logs
