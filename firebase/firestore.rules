rules_version = '2';
// La aplicación accede a Firestore solo desde el backend con el Admin SDK,
// que no está sujeto a estas reglas. Se bloquea todo acceso directo desde
// navegadores o apps cliente para proteger inventario, altas (incluyen PSK)
// y la bitácora de operaciones.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
